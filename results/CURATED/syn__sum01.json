  "source_text": "def f(n):\n    \"\"\"Sum of 0..n-1. Ground truth: n*(n-1)/2 if n>=0, else 0.\"\"\"\n    s = 0\n    i = 0\n    while i < n:\n        s = s + i\n        i = i + 1\n    assert s == n * (n - 1) // 2\n    return s\n",
